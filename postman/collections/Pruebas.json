	"item": [
		{
			"name": "Set Auth Header",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"id": "67aa98be-ccd7-446b-9662-a3e8af80f5a1",
						"exec": [
							"// Pre-request Script CORREGIDO\r",
							"pm.environment.set(\"authHeader\", \"Basic \" + pm.environment.get(\"authToken\"));\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"id": "643e609f-490e-47f5-a904-251c748d98af",
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"id": "2b9f80d1-fb05-43a0-b12c-08e5f68a8478",
			"protocolProfileBehavior": {
				"disableBodyPruning": true,
				"disabledSystemHeaders": {
					"content-type": true
				}
			},
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "password",
							"value": "{{password}}",
							"type": "string"
						},
						{
							"key": "username",
							"value": "{{username}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "{{authHeader}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "\r\n\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/Employees",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"Employees"
					]
				}
			},
			"response": []
		},
		{
			"name": "1.1Range-Validation(33)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "8e65bf31-975c-4ad4-99c0-47289d9a703f",
						"exec": [
							"pm.test(\"Dependants validation error message\", function () {\r",
							"    const response = pm.response.json();\r",
							"    const errorObject = response[0];\r",
							"// Verificar el mensaje de error específico\r",
							"    pm.expect(errorObject.errorMessage).to.equal('The field Dependants must be between 0 and 32.');\r",
							"\r",
							"    });"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
