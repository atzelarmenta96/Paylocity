	"item": [
		{
			"name": "1. Create Employee - Valid Data",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "537e1d27-8c60-4470-9598-b11f6a66cc31",
						"exec": [
							"// Verificar código de estado\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Verificar estructura de respuesta\r",
							"pm.test(\"Response has correct structure\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response).to.have.property('id');\r",
							"    pm.expect(response).to.have.property('firstName');\r",
							"    pm.expect(response).to.have.property('lastName');\r",
							"    pm.expect(response).to.have.property('dependants');\r",
							"    pm.expect(response).to.have.property('salary');\r",
							"    pm.expect(response).to.have.property('benefitsCost');\r",
							"    pm.expect(response).to.have.property('net');\r",
							"});\r",
							"\r",
							"// Verificar cálculos de beneficios\r",
							"pm.test(\"Benefits calculations are correct\", function () {\r",
							"    const response = pm.response.json();\r",
							"    const gross = pm.response.json().gross;\r",
							"    const dependants = pm.response.json().dependants;\r",
							"\r",
							"    const employeecost = 1000 // $1000 yearly for the employee\r",
							"    const dependantscost = 500 * dependants ;\r",
							"    const expectedBenefits = employeecost + dependantscost; // $1000 empleado + $1000 (2 dependientes)\r",
							"    const paidchecks = 26;\r",
							"    const benefictsmontlydeductions = expectedBenefits / paidchecks ; //    $2000 / 26\r",
							"    const expectedNet =  gross - benefictsmontlydeductions.toFixed(4) ; //\r",
							"    \r",
							"    pm.expect(response.net).to.equal(expectedNet);\r",
							"});\r",
							"\r",
							"// Guardar employeeId para pruebas posteriores\r",
							"const employeeId = pm.response.json().id;\r",
							"pm.environment.set(\"employeeId\", employeeId);\r",
							"pm.environment.set(\"username\", pm.response.json()\r",
							".username);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
