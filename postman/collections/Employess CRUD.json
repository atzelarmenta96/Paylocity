						"exec": [
							"pm.test(\"Check employee deletion with promise\", function () {\r",
							"    return new Promise((resolve, reject) => {\r",
							"        pm.sendRequest({\r",
							"            url: pm.environment.get(\"baseUrl\") + \"/api/Employees/\" + pm.environment.get(\"employeeIdd\"),\r",
							"            method: 'GET',\r",
							"            header: {\r",
							"                'Authorization': pm.environment.get(\"authHeader\"),\r",
							"                'Content-Type': 'application/json'\r",
							"            }\r",
							"        }, function (err, response) {\r",
							"            if (err) {\r",
							"                reject(err);\r",
							"                return;\r",
							"            }\r",
							"            \r",
							"            try {\r",
							"                pm.expect(response.code).to.equal(404);\r",
							"                resolve();\r",
							"            } catch (assertError) {\r",
							"                reject(assertError);\r",
							"            }\r",
							"        });\r",
							"    });\r",
							"});"
						],
