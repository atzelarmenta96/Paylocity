					}
				}
			],
			"id": "33a9a7bc-02ef-4f54-9fed-07379baade60",
			"protocolProfileBehavior": {
				"disableBodyPruning": true,
				"disabledSystemHeaders": {
					"content-type": true
				}
			},
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "password",
							"value": "{{password}}",
							"type": "string"
						},
						{
							"key": "username",
							"value": "{{username}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "{{authHeader}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "\r\n\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/Employees",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"Employees"
					]
				}
			},
			"response": []
		},
		{
			"name": "1.1Range-Validation(33)",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "b933e207-ed43-43fd-84ba-e6d9ba0b31be",
						"exec": [
							"pm.test(\"Dependants validation error message\", function () {\r",
							"    const response = pm.response.json();\r",
							"    const errorObject = response[0];\r",
							"// Verificar el mensaje de error específico\r",
							"    pm.expect(errorObject.errorMessage).to.equal('The field Dependants must be between 0 and 32.');\r",
							"\r",
							"    });"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
